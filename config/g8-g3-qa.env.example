# Template only. Copy to a NEW private file outside the checkout, chmod 600.
# Empty required values intentionally make Compose fail. Do not copy .env.vps.
# Use only: docker compose --env-file <private-QA-file> -f compose.g8-g3-qa.yaml ...
QA_BACKEND_IMAGE=
# Dedicated G8 runtime login, least privilege, TLS approved by DBA.
# The database must be exactly finet_global_validacion. Never crm_g8_prueba.
QA_DATABASE_URL=
QA_JWT_SECRET=
QA_FRONTEND_ORIGIN=
# Origin only: the client appends /api/integraciones/... . QA authorization required.
QA_G3_API_URL=
QA_G3_API_KEY=
# JSON: entries keyId, group=G3, sha256 (not raw key), companies, active.
# Only QA scopes explicitly authorized by G3/G8; no G1/G2 credentials.
QA_G8_INTEGRATION_API_KEYS=
# Both images must be referenced by immutable digest, never latest.
# Compose requires this even for API-only validation; omit starting the ui profile.
QA_FRONTEND_IMAGE=
# Proposed loopback ports; infrastructure owner must verify availability.
QA_BACKEND_PORT=18808
QA_FRONTEND_PORT=18809
