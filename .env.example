POSTGRES_DB=fsm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fsm_db?schema=public
JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=8h

BACKEND_PORT=3000
TRUST_PROXY_HOPS=0
REQUEST_TIMEOUT_MS=30000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
# Variable publica incorporada al bundle frontend; nunca colocar secretos VITE_*.
VITE_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3000

# Integracion Inventario/Bodega G1. La URL es la base publica entregada por G1.
# La clave debe intercambiarse por un canal seguro y nunca confirmarse en Git.
G1_API_URL=https://backend-production-6ada.up.railway.app
G1_API_KEY=
G1_REQUEST_TIMEOUT_MS=8000
G1_INTEGRATION_ENABLED=false

# API pública G8 para documentación/coordinación. No contiene secretos.
G8_PUBLIC_API_URL=https://team8-crm-production-3be0.up.railway.app/api
# Auth S2S entrante G8 para G2/G3. Usar una key distinta por grupo y guardar solo SHA-256.
# Formato: [{"keyId":"g3-prod-2026-01","group":"G3","sha256":"<64 hex minusculos>","companies":[1,2],"active":true},{"keyId":"g2-prod-2026-01","group":"G2","sha256":"<64 hex minusculos>","companies":[1,2],"active":true}]
G8_INTEGRATION_API_KEYS=[]

# TomoDAT: configurar solo en el servidor.
TOMODAT_API_URL=https://cl2.tomodat.com/tomodat/api/
TOMODAT_COMPANY_ID=
TOMODAT_API_TOKEN=

# Correo de cotizaciones (SMTP). Dejar SMTP_HOST vacio desactiva el envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRM FiNet
SMTP_HELO=

# Monitoreo tecnico basico. Si no hay medicion dentro de esta ventana, se muestra Sin dato reciente.
MONITORING_RECENT_HOURS=24

# Facturacion.cl: sandbox por empresa; deshabilitado sin perfil/credenciales.
FACTURACION_CL_INTEGRATION_ENABLED=false
FACTURACION_CL_COMPANIES=[]
FACTURACION_CL_PROFILES=[]
FACTURACION_CL_DELIVERY_ENABLED=false
FACTURACION_CL_FINET_SANDBOX_CREDENTIALS=
FACTURACION_CL_CABLE_MAGICO_SANDBOX_CREDENTIALS=

# WhatsApp Business pendiente de definicion con FiNet/Cable Magico.
# WHATSAPP_PROVIDER=disabled
# WHATSAPP_API_VERSION=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WABA_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=


# WhatsApp: habilitar Billing provider solo tras configurar/pruebar Meta.
# Ver docs/i3-whatsapp-integration.md. Nunca usar VITE_ para estos secretos.
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_VERSION=
WHATSAPP_COMPANIES=[]
WHATSAPP_FINET_ACCESS_TOKEN=
WHATSAPP_FINET_APP_SECRET=
WHATSAPP_FINET_VERIFY_TOKEN=
WHATSAPP_CABLE_MAGICO_ACCESS_TOKEN=
WHATSAPP_CABLE_MAGICO_APP_SECRET=
WHATSAPP_CABLE_MAGICO_VERIFY_TOKEN=
MAIL_PROVIDER=smtp
