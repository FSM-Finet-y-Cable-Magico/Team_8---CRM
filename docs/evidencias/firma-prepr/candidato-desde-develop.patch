+  assert.equal(result.status,1);assert.equal(result.stdout,'');
+  assert.doesNotMatch(result.stderr,/synthetic-only|example\\.invalid|postgresql:/);
+});
diff --git a/backend/src/contracts/signature-policy.ts b/backend/src/contracts/signature-policy.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/contracts/signature-policy.ts
@@ -0,0 +1,50 @@
+import { ConflictException } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { Prisma } from '@prisma/client';
+
+export type SignatureMode = 'automatic' | 'manual' | 'unknown';
+export const PENDING_SIGNATURE_STATES = ['Pendiente firma contrato'];
+export const AUTO_ASSIGNMENT_ACTION = 'ASIGNAR_FIRMA_AUTOMATICA';
+export function policyIds(config: ConfigService | undefined, key: string, fallback = '[]'): number[] {
+  const raw = config?.get<string>(key) ?? fallback;
+  let ids: unknown;
+  try { ids = JSON.parse(raw); } catch { throw new ConflictException('Política de firma no válida'); }
+  if (!Array.isArray(ids) || ids.some(n => !Number.isSafeInteger(n) || n < 1) || new Set(ids).size !== ids.length) {
+    throw new ConflictException('Política de firma no válida');
+  }
+  return ids;
+}
+export function automaticCompanies(config?: ConfigService) {
+  return policyIds(config, 'CONTRACT_SIGNATURE_AUTOMATIC_COMPANIES',
+    config?.get<string>('CONTRACT_SIGNATURE_COMPANIES') ?? '[]');
+}
+export async function resolveSignatureMode(tx: Prisma.TransactionClient, contract: { idContrato: number; idEmpresa: number | null },
+  config?: ConfigService): Promise<SignatureMode> {
+  // Assignment metadata only, never PDFs, OTP, tokens or personal evidence in public.
+  // Read even while sending is off or private storage is not provisioned.
+  const assigned = await tx.logAuditoria.findFirst({ where: {
+    entidadAfectada: 'contrato', idEntidadAfectada: contract.idContrato,
+    accion: { in: [AUTO_ASSIGNMENT_ACTION, 'SOLICITAR_FIRMA_CONTRATO', 'FIRMAR_CONTRATO_CORREO'] },
+  }, select: { idLog: true } });
+  if (assigned || contract.idEmpresa && automaticCompanies(config).includes(contract.idEmpresa)) return 'automatic';
+  const companies = policyIds(config, 'CONTRACT_SIGNATURE_MANUAL_COMPANIES');
+  const contracts = policyIds(config, 'CONTRACT_SIGNATURE_MANUAL_CONTRACTS');
+  return contract.idEmpresa && companies.includes(contract.idEmpresa) && contracts.includes(contract.idContrato) ? 'manual' : 'unknown';
+}
+export async function assignAutomatic(tx: Prisma.TransactionClient, contract: { idContrato: number; idEmpresa: number | null },
+  config?: ConfigService, idUsuario?: number) {
+  if (!contract.idEmpresa || !automaticCompanies(config).includes(contract.idEmpresa)) return;
+  const found = await tx.logAuditoria.findFirst({ where: { entidadAfectada: 'contrato',
+    idEntidadAfectada: contract.idContrato, accion: AUTO_ASSIGNMENT_ACTION }, select: { idLog: true } });
+  if (!found) await tx.logAuditoria.create({ data: { idUsuario: idUsuario ?? null, accion: AUTO_ASSIGNMENT_ACTION,
+    entidadAfectada: 'contrato', idEntidadAfectada: contract.idContrato,
+    valorNuevo: { idEmpresa: contract.idEmpresa, modo: 'automatic' } } });
+}
+export function assertPendingSignature(state: string) {
+  if (!PENDING_SIGNATURE_STATES.includes(state)) throw new ConflictException('El contrato no está pendiente de firma');
+}
+export function assertManualMode(mode: SignatureMode) {
+  if (mode !== 'manual') throw new ConflictException(mode === 'automatic'
+    ? 'El contrato requiere firma automática. La confirmación manual no está permitida.'
+    : 'El modo de firma no está autorizado. Solicita revisión del contrato.');
+}
diff --git a/backend/src/contracts/signature-schema.ts b/backend/src/contracts/signature-schema.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/contracts/signature-schema.ts
@@ -0,0 +1,38 @@
+import { Prisma } from '@prisma/client';
+export async function inspectPrivateSignatureSchema(tx: Prisma.TransactionClient) {
+  const columns = await tx.$queryRaw<Array<{ name: string; type: string; nullable: boolean }>>`
+    SELECT a.attname AS name, format_type(a.atttypid,a.atttypmod) AS type, NOT a.attnotnull AS nullable
+    FROM pg_attribute a WHERE a.attrelid=to_regclass('g8_contratos.solicitud_firma')
+      AND a.attnum>0 AND NOT a.attisdropped ORDER BY a.attnum`;
+  const constraints = await tx.$queryRaw<Array<{ name: string; kind: string; validated: boolean; definition: string }>>`
+    SELECT conname AS name, contype::text AS kind, convalidated AS validated, pg_get_constraintdef(oid) AS definition
+    FROM pg_constraint WHERE conrelid=to_regclass('g8_contratos.solicitud_firma') ORDER BY conname`;
+  const indexes = await tx.$queryRaw<Array<{ name: string; unique: boolean; valid: boolean; definition: string }>>`
+    SELECT c.relname AS name, i.indisunique AS unique, i.indisvalid AS valid, pg_get_indexdef(i.indexrelid) AS definition
+    FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid
+    WHERE i.indrelid=to_regclass('g8_contratos.solicitud_firma') ORDER BY c.relname`;
+  const permissions = await tx.$queryRaw<Array<{ runtime: string; owner: string; superuser: boolean; usage: boolean; create: boolean;
+    select: boolean; insert: boolean; update: boolean; delete: boolean }>>`
+    SELECT current_user AS runtime, pg_get_userbyid(c.relowner) AS owner, r.rolsuper AS superuser,
+      has_schema_privilege(current_user,n.oid,'USAGE') AS usage, has_schema_privilege(current_user,n.oid,'CREATE') AS "create",
+      has_table_privilege(current_user,c.oid,'SELECT') AS "select", has_table_privilege(current_user,c.oid,'INSERT') AS "insert",
+      has_table_privilege(current_user,c.oid,'UPDATE') AS "update", has_table_privilege(current_user,c.oid,'DELETE') AS "delete"
+    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_roles r ON r.rolname=current_user
+    WHERE n.nspname='g8_contratos' AND c.relname='solicitud_firma'`;
+  const violations: string[] = [];
+  const required = ['firma_state_check','firma_hash_check','firma_otp_check','firma_pdf_check','firma_snapshot_check',
+    'firma_expiry_check','firma_signed_check','firma_mail_check','firma_version_check'];
+  if (columns.length !== 29) violations.push('COLUMNS');
+  if (constraints.some(c => c.kind === 'f')) violations.push('CROSS_SCHEMA_FK');
+  if (required.some(name => !constraints.some(c => c.name === name && c.validated && c.kind === 'c'))) violations.push('CHECKS');
+  const definitions = Object.fromEntries(constraints.map(c => [c.name, c.definition.replace(/\s+/g,' ').toLowerCase()]));
+  if (!definitions.firma_otp_check?.includes('>= 0') || !definitions.firma_otp_check.includes('<= 5')
+    || definitions.firma_otp_check.includes('between')) violations.push('OTP_BOUNDS');
+  if (!definitions.firma_pdf_check?.includes('<= 4194304') || !definitions.firma_pdf_check.includes('<= 5242880')
+    || definitions.firma_pdf_check.includes('between')) violations.push('PDF_BOUNDS');
+  const requiredIndexes = ['firma_token_key','firma_document_key','firma_pending_contract_key','firma_version_key','firma_company_contract_idx'];
+  if (requiredIndexes.some(name => !indexes.some(i => i.name === name && i.valid))) violations.push('INDEXES');
+  const p = permissions[0];
+  if (!p || p.superuser || p.owner === p.runtime || !p.usage || p.create || !p.select || !p.insert || !p.update || p.delete) violations.push('RUNTIME_PERMISSIONS');
+  return { ready: !violations.length, violations, columns, constraints, indexes, permissions };
+}
