# Copiar como .env.railway. El archivo real queda ignorado por Git.
# Desde Docker local se debe usar la URL publica/TCP Proxy de Railway,
# no el hostname privado *.railway.internal.
DATABASE_URL=postgresql://postgres:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST_PROXY:REEMPLAZAR_PUERTO/railway?schema=public

JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=8h
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=30000
FRONTEND_URL=https://REEMPLAZAR_FRONTEND_PUBLICO

# Puertos alternativos para poder ejecutar el stack local y Railway a la vez.
RAILWAY_BACKEND_PORT=3001
RAILWAY_FRONTEND_PORT=5174
# Variable publica incorporada al bundle. Para el servicio frontend Railway usar
# https://team8-crm-production-3be0.up.railway.app/api durante el build.
VITE_API_URL=/api

# Integracion Inventario/Bodega G1. Configurar tambien estas variables en el
# servicio backend de Railway cuando exista un despliegue de la API G8.
G1_API_URL=
G1_API_KEY=
G1_REQUEST_TIMEOUT_MS=8000
G1_INTEGRATION_ENABLED=false

G8_PUBLIC_API_URL=https://team8-crm-production-3be0.up.railway.app/api
# Solo hashes SHA-256 y scopes; la key real se entrega por canal seguro.
G8_INTEGRATION_API_KEYS=[]

# Cobertura G3. Mantener deshabilitada mientras no exista contrato operativo.
COVERAGE_TECHNICAL_PROVIDER=G3
G3_API_URL=
G3_API_KEY=
G3_REQUEST_TIMEOUT_MS=8000
G3_INTEGRATION_ENABLED=false
GEOCODING_PROVIDER=MANUAL
GEOCODING_API_URL=

# TomoDAT: ID de empresa FiNet en esta base y token de su cuenta.
TOMODAT_API_URL=
TOMODAT_COMPANY_ID=
TOMODAT_API_TOKEN=

# Correo de cotizaciones (SMTP). Usar credenciales del proveedor autorizado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRM FiNet
SMTP_HELO=

MONITORING_RECENT_HOURS=24
BILLING_CUT_DAYS=5
BILLING_NOTIFICATION_MODE=disabled
COMMERCIAL_PLAN_EXPIRY_ALERT_DAYS=7

# Facturacion.cl permanece bloqueado hasta cerrar contrato tecnico e idempotencia.
FACTURACION_CL_INTEGRATION_ENABLED=false
FACTURACION_CL_COMPANIES=[]
