DATABASE_URL=
JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=8h
PORT=3000
TRUST_PROXY_HOPS=0
REQUEST_TIMEOUT_MS=30000
# Cobertura tecnica: G3 es el proveedor por defecto. Sin URL, el resultado queda pendiente.
COVERAGE_TECHNICAL_PROVIDER=G3
G3_API_URL=
G3_API_KEY=
G3_REQUEST_TIMEOUT_MS=8000
G3_INTEGRATION_ENABLED=false

# Geocodificacion opcional. MANUAL mantiene el selector de mapa sin llamadas externas.
GEOCODING_PROVIDER=MANUAL
GEOCODING_API_URL=

# LEGACY: usar TomoDAT directo solo con COVERAGE_TECHNICAL_PROVIDER=LEGACY_TOMODAT.
# El token se configura solo en servidor; nunca usar VITE_ para secretos.
TOMODAT_API_URL=
TOMODAT_COMPANY_ID=
TOMODAT_API_TOKEN=
# Use comma-separated origins if the backend is exposed directly.
FRONTEND_URL=http://localhost:5173

# Correo de cotizaciones (SMTP). Dejar SMTP_HOST vacio desactiva el envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRM FiNet
SMTP_HELO=

# Monitoreo tecnico basico. Si no hay medicion dentro de esta ventana, se muestra Sin dato reciente.
MONITORING_RECENT_HOURS=24

# Parametros comerciales y de cobranza. No ejecutan cortes ni envios externos.
BILLING_CUT_DAYS=5
BILLING_NOTIFICATION_MODE=mock
COMMERCIAL_PLAN_EXPIRY_ALERT_DAYS=7

# Facturacion.cl: mantener false hasta confirmar contrato, credenciales e idempotencia.
# JSON no secreto: [{"idEmpresa":1,"alias":"FINET","environment":"sandbox","enabled":false}]
FACTURACION_CL_INTEGRATION_ENABLED=false
FACTURACION_CL_COMPANIES=[]

# WhatsApp Business pendiente de definicion con FiNet/Cable Magico.
# WHATSAPP_PROVIDER=disabled
# WHATSAPP_API_VERSION=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WABA_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Inventario/Bodega G1. URL y dos GET reales confirmados; el POST sigue sin autorización.
# Mantener deshabilitado hasta que G1 confirme una asociación funcional de activación.
G1_API_URL=https://backend-production-6ada.up.railway.app
G1_API_KEY=
G1_REQUEST_TIMEOUT_MS=8000
G1_INTEGRATION_ENABLED=false

# API pública G8 para documentación/coordinación. No contiene secretos.
G8_PUBLIC_API_URL=https://team8-crm-production-3be0.up.railway.app/api
# Auth S2S entrante G8 para G2/G3. Una key distinta por grupo; almacenar solo SHA-256.
# Formato: [{"keyId":"g3-prod-2026-01","group":"G3","sha256":"<64 hex minusculos>","companies":[1,2],"active":true},{"keyId":"g2-prod-2026-01","group":"G2","sha256":"<64 hex minusculos>","companies":[1,2],"active":true}]
G8_INTEGRATION_API_KEYS=[]
