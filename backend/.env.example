DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fsm_db?schema=public
JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=8h
PORT=3000
# Cobertura tecnica: G3 es el proveedor por defecto. Sin URL, el resultado queda pendiente.
COVERAGE_TECHNICAL_PROVIDER=G3
G3_API_URL=
G3_API_KEY=
G3_REQUEST_TIMEOUT_MS=8000
G3_INTEGRATION_ENABLED=false

# Geocodificacion opcional. MANUAL mantiene el selector de mapa sin llamadas externas.
GEOCODING_PROVIDER=MANUAL
GEOCODING_API_URL=

# LEGACY: usar TomoDAT directo solo con COVERAGE_TECHNICAL_PROVIDER=LEGACY_TOMODAT.
# El token se configura solo en servidor; nunca usar VITE_ para secretos.
TOMODAT_API_URL=https://cl2.tomodat.com/tomodat/api/
TOMODAT_COMPANY_ID=
TOMODAT_API_TOKEN=
# Use comma-separated origins if the backend is exposed directly.
FRONTEND_URL=http://localhost:5173

# Correo de cotizaciones (SMTP). Dejar SMTP_HOST vacio desactiva el envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRM FiNet

# Monitoreo tecnico basico. Si no hay medicion dentro de esta ventana, se muestra Sin dato reciente.
MONITORING_RECENT_HOURS=24

# Parametros comerciales y de cobranza. No ejecutan cortes ni envios externos.
BILLING_CUT_DAYS=5
BILLING_NOTIFICATION_MODE=mock
COMMERCIAL_PLAN_EXPIRY_ALERT_DAYS=7

# WhatsApp Business pendiente de definicion con FiNet/Cable Magico.
# WHATSAPP_PROVIDER=disabled
# WHATSAPP_API_VERSION=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WABA_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Inventario/Bodega G1. Mantener deshabilitado hasta que G1 confirme el despliegue de P0/P1.
G1_API_URL=
G1_API_KEY=
G1_REQUEST_TIMEOUT_MS=8000
G1_INTEGRATION_ENABLED=false
